custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Continuar"

[node name="RestartButton" type="Button" parent="Frame/PauseOverlay/Center/ModalPanel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Reiniciar entrenamiento"

[node name="DevelopmentButton" type="Button" parent="Frame/PauseOverlay/Center/ModalPanel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Desarrollo"

[node name="QuitButton" type="Button" parent="Frame/PauseOverlay/Center/ModalPanel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Salir"

[node name="ModalHint" type="Label" parent="Frame/PauseOverlay/Center/ModalPanel/Rows"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.74, 0.80, 0.87, 1)
theme_override_font_sizes/font_size = 16
text = "Flechas / Stick · Elegir     Intro / A · Aceptar
Esc / B / Menú · Continuar"
horizontal_alignment = 1
autowrap_mode = 3

[node name="EventTimer" type="Timer" parent="."]
wait_time = 2.5
one_shot = true
ignore_time_scale = true

[node name="RestartFeedbackTimer" type="Timer" parent="."]
wait_time = 1.5
one_shot = true
ignore_time_scale = true

[connection signal="pressed" from="Frame/PauseButton" to="." method="_on_pause_pressed"]
[connection signal="pressed" from="Frame/PauseOverlay/Center/ModalPanel/Rows/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Frame/PauseOverlay/Center/ModalPanel/Rows/RestartButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="Frame/PauseOverlay/Center/ModalPanel/Rows/DevelopmentButton" to="." method="_on_development_pressed"]
[connection signal="pressed" from="Frame/PauseOverlay/Center/ModalPanel/Rows/QuitButton" to="." method="_on_quit_pressed"]
[connection signal="timeout" from="EventTimer" to="." method="_on_event_timeout"]
[connection signal="timeout" from="RestartFeedbackTimer" to="." method="_on_restart_feedback_timeout"]
